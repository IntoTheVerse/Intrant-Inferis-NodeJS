{
  "compilerOptions": {
    /* Language and Environment */
    "target": "es2016",                                  /* Set the JavaScript language version for emitted JavaScript. */
    "module": "commonjs",                                /* Specify the module code to be commonjs. */
    "rootDir": "./",                                     /* Specify the root folder for source files. */
    "outDir": "./dist",                                  /* Output all compiled files into the dist folder. */
    "moduleResolution": "node",                          /* Resolve modules based on node-style. */
    "resolveJsonModule": true,                           /* Enable importing .json files. */
    "esModuleInterop": true,                            /* Don't emit extra JavaScript for CommonJS modules. */
    "forceConsistentCasingInFileNames": true,            /* Enforce consistent casing in imports. */
    
    /* Emit */
    "importHelpers": true,                               /* Allow importing helper functions from tslib. */
    "downlevelIteration": true,                          /* Emit more compliant code for iteration. */
    "strict": true,                                      /* Enable all strict type-checking options. */
    "noEmitOnError": true,                               /* Disable emitting files if any type checking errors are found. */
    "skipLibCheck": true,                                /* Skip type checking all .d.ts files. */
    
    /* Type Checking */
    "noImplicitReturns": true,                           /* Enable error reporting for missing returns. */
    "noFallthroughCasesInSwitch": true,                  /* Enable error reporting for fallthrough cases in switch statements. */
    "noUnusedLocals": true,                              /* Enable error reporting when local variables are not used. */
    "noUnusedParameters": true,                          /* Raise an error when a function parameter isn't read. */
    
    /* Source Map Support */
    "sourceMap": true                                    /* Create source map files for emitted JavaScript files. */
  },
  
  /* Include and Exclude */
  "include": [
    "index.ts",                                          /* Include index.ts at root. */
    "config/**/*.ts"                                     /* Include all TypeScript files in the config folder. */
  ],
  "exclude": [
    "node_modules"                                       /* Exclude node_modules. */
  ]
}
